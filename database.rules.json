{
  "rules": {
    ".read": false,
    ".write": false,

    "gymTracker": {
      "appVersion": {
        ".read": true
      },

      "allowlist": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      },

      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid && root.child('gymTracker/allowlist').child(auth.uid).exists()",
          ".write": "auth != null && auth.uid === $uid && root.child('gymTracker/allowlist').child(auth.uid).exists()",

          "schedule": {
            "$day": {
              ".validate": "$day.beginsWith('day')"
            }
          },

          "logs": {
            "$logId": {
              ".validate": "newData.hasChildren(['exercise', 'date'])",
              "exercise":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
              "date":          { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
              "day":           { ".validate": "newData.isNumber() || newData.val() == null" },
              "sessionNumber": { ".validate": "newData.isNumber()" },
              "sessionName":   { ".validate": "newData.isString() || newData.val() == null" },
              "totalReps":     { ".validate": "newData.isNumber()" },
              "weight":        { ".validate": "newData.isNumber() || newData.val() == null" },
              "sets": {
                "$i": {
                  "reps": { ".validate": "newData.isNumber()" },
                  "$other": { ".validate": false }
                }
              },
              "$other": { ".validate": false }
            }
          }
        }
      }
    }
  }
}
